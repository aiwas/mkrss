@page "/admin"
@rendermode InteractiveServer
@inject ISiteRepository Sites

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">ウェブサイト一覧</MudText>
    <MudButton Href="/admin/sites/new"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">
        新しいウェブサイトを登録する
    </MudButton>
</MudStack>

@if (_sites is null) {
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
} else if (_sites.Count == 0) {
    <MudAlert Severity="Severity.Info">登録されているウェブサイトがありません。</MudAlert>
} else {
    <MudTable Items="_sites" Hover="true" Dense="true" Elevation="1">
        <HeaderContent>
            <MudTh>名前</MudTh>
            <MudTh>slug</MudTh>
            <MudTh>一覧ページ</MudTh>
            <MudTh>巡回</MudTh>
        </HeaderContent>
        <RowTemplate Context="site">
            <MudTd DataLabel="名前">
                <MudLink Href="@($"/admin/sites/{site.Id}")" Style="font-weight: bold;">
                    @site.Draft.Name
                </MudLink>
            </MudTd>
            <MudTd DataLabel="slug">
                <MudLink Href="@($"/feeds/{site.Draft.Slug}.xml")" Target="_blank" Class="mkrss-mono">
                    @site.Draft.Slug
                </MudLink>
            </MudTd>
            <MudTd DataLabel="一覧ページ">
                <MudLink Href="@site.Draft.PageUrl" Target="_blank" Class="mkrss-mono">@site.Draft.PageUrl</MudLink>
            </MudTd>
            @* 状態の表示と切り替えを1つにまとめる。
               スイッチの位置がそのまま現在の状態を表す。 *@
            <MudTd DataLabel="巡回">
                <MudSwitch T="bool"
                           Value="site.Draft.IsEnabled"
                           ValueChanged="@(value => SetEnabledAsync(site, value))"
                           Color="Color.Primary"
                           aria-label="@($"{site.Draft.Name} を巡回の対象にする")" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudText Typo="Typo.caption" Class="mt-2 ml-2 d-block">
        巡回を中止しても、取得済のフィードの配信は継続されます。
    </MudText>
}

@code {
    private IReadOnlyList<SiteDefinition>? _sites;

    protected override async Task OnInitializedAsync() {
        await LoadAsync();
    }

    private async Task LoadAsync() {
        _sites = await Sites.ListAsync(CancellationToken.None);
    }

    private async Task SetEnabledAsync(SiteDefinition site, bool isEnabled) {
        await Sites.SetEnabledAsync(site.Id, isEnabled, CancellationToken.None);

        // 表示している値の出どころをDBに一本化する。
        // スイッチの状態だけを書き換えると、保存に失敗したときに食い違う。
        await LoadAsync();
    }
}
