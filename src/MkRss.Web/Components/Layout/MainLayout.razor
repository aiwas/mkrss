@inherits LayoutComponentBase

@* ダークモードは使わない。IsDarkMode を指定しなければ、OSの設定にかかわらず常にライトで表示する。 *@
<MudThemeProvider Theme="Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudLink Href="/admin" Color="Color.Inherit" Underline="Underline.None" Typo="Typo.h6">mkrss</MudLink>
        <MudSpacer />
        <MudButton Href="/admin" Color="Color.Inherit">ウェブサイト一覧</MudButton>
        <MudButton Href="/admin/runs" Color="Color.Inherit">実行履歴</MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    /// <summary>
    /// 画面全体のテーマ。
    /// </summary>
    /// <remarks>
    /// MudBlazor の既定のタイポグラフィは Roboto を前提にしているが、
    /// 読み込むと管理画面を開くたびに外部へリクエストが飛ぶ。
    /// ここでシステムのフォントを指定し、Google Fonts を参照しない。
    /// </remarks>
    private static readonly MudTheme Theme = new() {
        PaletteLight = new PaletteLight() {
            Primary = "#eb7057",
            AppbarBackground = "#eb7057",
            Success = "#57ebba",
            SuccessContrastText = "#000000",
            Warning = "#ebba57",
            WarningContrastText = "#000000",
        },
        Typography = new Typography {
            Default = new DefaultTypography {
                FontFamily = ["Noto Sans JP", "system-ui", "sans-serif"],
            },
        },
    };
}
