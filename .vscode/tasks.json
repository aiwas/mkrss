{
    "version": "2.0.0",
    "tasks": [
        {
            // launch.json の preLaunchTask から呼ぶ。
            // ソリューションはリポジトリのルートにある (src/ ではない)。
            "label": "build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/MkRss.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
